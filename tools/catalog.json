{
  "schema": "nexus-lab/tool-catalog/v2",
  "policy": {
    "automatic_installation": false,
    "network_default": "denied",
    "required_records": ["origin", "license", "version", "binary_sha256", "signature_status", "validation_reference"]
  },
  "capabilities": [
    {"id":"sqlite","disposition":"windows-native","providers":[{"id":"sqlite3","command":"sqlite3","origin":"https://sqlite.org/download.html","license":"public-domain"}]},
    {"id":"json-query","disposition":"windows-native","providers":[{"id":"jq","command":"jq","origin":"https://jqlang.org/download/","license":"MIT"}]},
    {"id":"archive-inspection","disposition":"windows-native","providers":[{"id":"7zip","command":"7z","origin":"https://www.7-zip.org/","license":"LGPL-2.1-or-later"}]},
    {"id":"text-search","disposition":"windows-native","providers":[{"id":"ripgrep","command":"rg","origin":"https://github.com/BurntSushi/ripgrep","license":"MIT OR Unlicense"}]},
    {"id":"file-identification","disposition":"replacement","replaces":["file"],"providers":[{"id":"detect-it-easy","command":"diec","origin":"https://github.com/horsicq/Detect-It-Easy","license":"MIT"}]},
    {"id":"hex-inspection","disposition":"replacement","replaces":["xxd"],"providers":[{"id":"powershell-format-hex","command":"pwsh","origin":"https://learn.microsoft.com/powershell/module/microsoft.powershell.utility/format-hex","license":"MIT"}]},
    {"id":"integrity-inventory","disposition":"replacement","replaces":["hashdeep","sha256sum","sha512sum"],"providers":[{"id":"nexus-hashing","command":"python","origin":"repository:python/nexus_lab/hashing.py","license":"project"}]},
    {"id":"disk-filesystem","disposition":"windows-native","providers":[{"id":"sleuthkit","command":"mmls","origin":"https://www.sleuthkit.org/sleuthkit/download.php","license":"CPL-1.0"}]},
    {"id":"file-recovery","disposition":"windows-native","providers":[{"id":"testdisk","command":"testdisk_win","origin":"https://www.cgsecurity.org/wiki/TestDisk_Download","license":"GPL-2.0-or-later"}]},
    {"id":"pattern-detection","disposition":"windows-native","providers":[{"id":"yara","command":"yara","origin":"https://github.com/VirusTotal/yara/releases","license":"BSD-3-Clause"}]},
    {"id":"metadata","disposition":"windows-native","providers":[{"id":"exiftool","command":"exiftool","origin":"https://exiftool.org/","license":"Artistic-1.0 OR GPL-1.0-or-later"}]},
    {"id":"pdf-structure","disposition":"windows-native","providers":[{"id":"qpdf","command":"qpdf","origin":"https://github.com/qpdf/qpdf/releases","license":"Apache-2.0"},{"id":"mupdf","command":"mutool","origin":"https://mupdf.com/releases","license":"AGPL-3.0-or-later"}]},
    {"id":"pdf-render","disposition":"windows-native","providers":[{"id":"ghostscript","command":"gswin64c","origin":"https://ghostscript.com/releases/gsdnld.html","license":"AGPL-3.0-or-later"}]},
    {"id":"pdf-signatures","disposition":"windows-native","providers":[{"id":"pyhanko","command":"pyhanko","origin":"https://github.com/MatthiasValvekens/pyHanko","license":"MIT"}]},
    {"id":"pdf-conformance","disposition":"windows-native","providers":[{"id":"verapdf","command":"verapdf","origin":"https://verapdf.org/software/","license":"GPL-3.0-or-later/MPL-2.0"}]},
    {"id":"openpgp","disposition":"windows-native","providers":[{"id":"gpg4win","command":"gpg","origin":"https://gpg4win.org/download.html","license":"GPL"}]},
    {"id":"pcap-analysis","disposition":"windows-native","providers":[{"id":"tshark","command":"tshark","origin":"https://www.wireshark.org/download.html","license":"GPL-2.0-or-later"}]},
    {"id":"android-bridge","disposition":"windows-native","providers":[{"id":"adb","command":"adb","origin":"https://developer.android.com/tools/releases/platform-tools","license":"Android-SDK-License"}]},
    {"id":"memory-analysis","disposition":"windows-native","providers":[{"id":"volatility3","command":"vol","origin":"https://github.com/volatilityfoundation/volatility3","license":"VSL-1.0"}]},
    {"id":"endpoint-artifacts","disposition":"windows-native","providers":[{"id":"velociraptor","command":"velociraptor","origin":"https://github.com/Velocidex/velociraptor/releases","license":"AGPL-3.0"}]},
    {"id":"windows-registry","disposition":"replacement","replaces":["hivex","reglookup"],"providers":[{"id":"recmd","command":"RECmd","origin":"https://github.com/EricZimmerman/RECmd","license":"MIT"}]},
    {"id":"binary-strings","disposition":"replacement","replaces":["binutils-strings"],"providers":[{"id":"sysinternals-strings","command":"strings","origin":"https://learn.microsoft.com/sysinternals/downloads/strings","license":"Microsoft-Sysinternals-EULA"}]},
    {"id":"ewf","disposition":"conditional","providers":[{"id":"libewf-native","command":"ewfinfo","origin":"https://github.com/libyal/libewf","license":"LGPL-3.0-or-later"}]},
    {"id":"poppler-pdf","disposition":"conditional","providers":[{"id":"poppler-native","command":"pdfinfo","origin":"https://poppler.freedesktop.org/","license":"GPL-2.0-or-later"}]},
    {"id":"cms-certificates","disposition":"conditional","providers":[{"id":"openssl-native","command":"openssl","origin":"https://www.openssl.org/source/","license":"Apache-2.0"}]},
    {"id":"pdf-ocr","disposition":"conditional","providers":[{"id":"tesseract","command":"tesseract","origin":"https://github.com/tesseract-ocr/tesseract","license":"Apache-2.0"}]},
    {"id":"bulk-extraction","disposition":"conditional","providers":[{"id":"bulk-extractor","command":"bulk_extractor","origin":"https://github.com/simsong/bulk_extractor","license":"MIT"}]},
    {"id":"virtual-disk","disposition":"conditional","providers":[{"id":"qemu-img-native","command":"qemu-img","origin":"https://www.qemu.org/download/#windows","license":"GPL-2.0"}]},
    {"id":"forensic-suite","disposition":"conditional","providers":[{"id":"autopsy","command":"autopsy64","origin":"https://www.autopsy.com/download/","license":"Apache-2.0"}]},
    {"id":"image-mounting","disposition":"conditional","providers":[{"id":"arsenal-image-mounter","command":"aim_cli","origin":"https://github.com/ArsenalRecon/Arsenal-Image-Mounter","license":"external-allowlist-review-required"}]},
    {"id":"timeline","disposition":"hyperv-worker","providers":[{"id":"plaso","command":"log2timeline.py","origin":"https://github.com/log2timeline/plaso","license":"Apache-2.0"}]},
    {"id":"guest-filesystem","disposition":"hyperv-worker","providers":[{"id":"libguestfs","command":"guestfish","origin":"https://libguestfs.org/","license":"LGPL-2.1-or-later"}]},
    {"id":"image-translation","disposition":"hyperv-worker","providers":[{"id":"xmount","command":"xmount","origin":"https://www.pinguin.lu/xmount","license":"GPL-3.0"}]},
    {"id":"aff-image","disposition":"hyperv-worker","providers":[{"id":"afflib","command":"affinfo","origin":"https://github.com/sshock/AFFLIBv3","license":"BSD-4-Clause"}]},
    {"id":"carving","disposition":"hyperv-worker","providers":[{"id":"foremost","command":"foremost","origin":"https://foremost.sourceforge.net/","license":"public-domain"},{"id":"scalpel","command":"scalpel","origin":"https://github.com/sleuthkit/scalpel","license":"Apache-2.0"}]},
    {"id":"advanced-pdf-ocr","disposition":"hyperv-worker","providers":[{"id":"ocrmypdf","command":"ocrmypdf","origin":"https://github.com/ocrmypdf/OCRmyPDF","license":"MPL-2.0"}]},
    {"id":"xml-signature","disposition":"hyperv-worker","providers":[{"id":"xmlsec","command":"xmlsec1","origin":"https://www.aleksey.com/xmlsec/","license":"MIT"}]},
    {"id":"nss-certificates","disposition":"hyperv-worker","providers":[{"id":"nss-certutil","command":"certutil","origin":"https://firefox-source-docs.mozilla.org/security/nss/","license":"MPL-2.0"}]}
  ]
}

